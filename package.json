{
  "name": "digital-cv-vue",
  "version": "3.0.0",
  "description": "Modern Digital CV built with Vue.js 3 and Webpack",
  "main": "src/main.js",
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "clean": "rimraf dist",
    "serve": "http-server dist -p 12345 -c-1 -o",
    "analyze": "webpack --mode production --analyze",
    "lint": "eslint --ext .js,.vue src",
    "lint:fix": "eslint --ext .js,.vue src --fix"
  },
  "keywords": [
    "cv",
    "resume",
    "portfolio",
    "vue",
    "vue3",
    "webpack"
  ],
  "author": "Biswasindhu Mandal",
  "license": "ISC",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "axios": "^1.6.5",
    "bootstrap": "^4.6.2",
    "aos": "^2.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@vue/compiler-sfc": "^3.4.15",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "file-loader": "^6.2.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.69.7",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.10",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "copy-webpack-plugin": "^12.0.2",
    "rimraf": "^5.0.5",
    "http-server": "^14.1.1"
  }
}
